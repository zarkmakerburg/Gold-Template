#!/usr/bin/env bash
# row-template CLI launcher — installed as both gold-template and row-template.
#
# This thin dispatcher sources the management library from the Gold-Template
# install root and hands off to the rt_cmd_* functions. The exact string
# "row-template CLI launcher" above is retained as the ownership marker the
# uninstaller checks before removing either launcher.

set -Eeuo pipefail

RT_CLI_NAME="${0##*/}"

# The install root is decided at install time by the panel: 3X-UI installs live
# at /etc/3x-ui/sub_templates/row-template (every release), PasarGuard and
# Rebecca installs at /etc/row-template (1.3.0+). The launcher uses whichever
# one holds a management library. RT_ROOT may be overridden in the environment
# for testing; the library reads the same variable.
if [ -z "${RT_ROOT:-}" ]; then
  for rt_candidate in /etc/3x-ui/sub_templates/row-template /etc/row-template; do
    if [ -r "$rt_candidate/lib/row-template.sh" ]; then RT_ROOT="$rt_candidate"; break; fi
  done
  unset rt_candidate
fi
RT_ROOT="${RT_ROOT:-/etc/3x-ui/sub_templates/row-template}"
RT_LIB="${RT_LIB_OVERRIDE:-$RT_ROOT/lib/row-template.sh}"

if [ ! -r "$RT_LIB" ]; then
  printf '%s: management library not found at %s\n' "$RT_CLI_NAME" "$RT_LIB" >&2
  printf '%s: the install may be damaged; re-run the installer.\n' "$RT_CLI_NAME" >&2
  exit 1
fi

# shellcheck source=/dev/null
. "$RT_LIB"

trap 'rt_err "unexpected error (line $LINENO); no partial change was committed."' ERR
trap 'rt_cleanup' EXIT

# No arguments: open the interactive manager when attached to a terminal;
# otherwise (scripts, CI, curl | bash) fall back to help so nothing ever hangs
# waiting for input. RT_ASSUME_NONINTERACTIVE forces the non-interactive path.
if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ] && [ -z "${RT_ASSUME_NONINTERACTIVE:-}" ]; then
    cmd="menu"
  else
    cmd="help"
  fi
else
  cmd="$1"; shift
fi

case "$cmd" in
  config)              rt_cmd_config "$@" ;;
  update)              rt_cmd_update "$@" ;;
  rollback)            rt_cmd_rollback "$@" ;;
  verify)              rt_cmd_verify "$@" ;;
  version|-v|--version) rt_cmd_version "$@" ;;
  help|-h|--help)      rt_print_help ;;
  menu|manager)        rt_manager_main "$@" ;;
  uninstall)           rt_cmd_uninstall "$@" ;;
  *)
    rt_err "unknown command: $cmd"
    rt_print_help >&2
    exit 2
    ;;
esac
